# LLM 配置（厨师大脑）
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL_NAME=gpt-4o

# E2B 沙箱（厨具设施）
E2B_API_KEY=your_e2b_api_key

# Blender 官方 MCP（Blender Lab 源码，默认 vendor/blender_mcp）
# host 固定为 localhost，端口在 .env 中配置
BLENDER_MCP_COMMAND=uv
BLENDER_MCP_DIR=./vendor/blender_mcp
BLENDER_MCP_PORT=9876

# ElevenLabs REST（TTS / SFX / BGM；密钥会注入 E2B 沙箱）
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# 阿里云百炼（TTS / SFX / BGM；密钥会注入 E2B 沙箱）
DASHSCOPE_API_KEY=your_dashscope_api_key
