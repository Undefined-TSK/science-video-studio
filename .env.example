# LLM 配置（厨师大脑）
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL_NAME=gpt-4o

# E2B 沙箱（厨具设施）
E2B_API_KEY=your_e2b_api_key

# Blender 官方 MCP（Blender Lab 源码，默认 vendor/blender_mcp）
# 运行前提：Blender 5.1+ 已启动，并安装、启用官方 add-on
BLENDER_MCP_COMMAND=uv
BLENDER_MCP_DIR=./vendor/blender_mcp

# ElevenLabs 托管 MCP（仅 TTS）
ELEVENLABS_TOKEN=your_elevenlabs_token

# ElevenLabs REST（SFX / BGM）
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# 阿里云百炼（TTS / SFX / BGM）
DASHSCOPE_API_KEY=your_dashscope_api_key
